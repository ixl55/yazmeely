# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى GitHub أبداً!

# توكن البوت من @BotFather (إلزامي)
BOT_TOKEN=

# أرقام المسؤولين مفصولة بفاصلة
ADMIN_IDS=123456789

# قناة الاشتراك الإجباري (اختياري — اتركه فارغاً للتعطيل). يجب أن يكون البوت مشرفاً فيها.
REQUIRED_CHANNEL=

# الحدود
MAX_DURATION_MINUTES=90
MAX_FILE_SIZE_MB=50
MAX_CONCURRENT_DOWNLOADS=2
VIDEO_MAX_HEIGHT=720

# ===== حلول حظر يوتيوب (راجع README) =====
# بروكسي سكني (residential) أو WARP. أمثلة:
#   http://user:pass@host:port
#   socks5://127.0.0.1:40000
PROXY=

# خادم PO Token (bgutil). في docker-compose يكون: http://bgutil-provider:4416
POT_PROVIDER_URL=

# عملاء يوتيوب (اختياري). مثال: default,tv,web_safari
YT_PLAYER_CLIENTS=

# Local Bot API Server لرفع ملفات حتى 2000MB (اختياري). مثال: http://telegram-bot-api:8081
TELEGRAM_API_URL=

# خادم الويب (لاستضافات مثل Render/Replit). ضع 0 لتعطيله
WEB_SERVER=1
PORT=8080

DATA_DIR=data
